example (k : ℕ) (hk : 3 ≤ k) :
    ∃ s₀ : ℕ, ∀ s n : ℕ, s₀ ≤ s → k * (s + 1) ≤ n →
      ∀ H : Finset (Finset (Fin n)),
        (∀ e ∈ H, e.card = k) →
        (∀ M : Finset (Finset (Fin n)), M ⊆ H →
          (∀ e ∈ M, ∀ f ∈ M, e ≠ f → Disjoint e f) → M.card ≤ s) →
        H.card ≤ max (Nat.choose n k - Nat.choose (n - s) k)
          (Nat.choose (k * (s + 1) - 1) k) := by
  simpa only [SharpTailMatching.IsUniform, SharpTailMatching.MatchingNumberAtMost,
    SharpTailMatching.coverSize, SharpTailMatching.cliqueSize]
    using SharpTailMatching.large_matching_bound k hk

example (k : ℕ) (hk : 3 ≤ k) :
    ∃ s₀ : ℕ, ∀ s n : ℕ, s₀ ≤ s → k * (s + 1) ≤ n →
      ∀ H : Finset (Finset (Fin n)),
        (∀ e ∈ H, e.card = k) →
        (∀ M : Finset (Finset (Fin n)), M ⊆ H →
          (∀ e ∈ M, ∀ f ∈ M, e ≠ f → Disjoint e f) → M.card ≤ s) →
        (H.card = max (Nat.choose n k - Nat.choose (n - s) k)
          (Nat.choose (k * (s + 1) - 1) k) ↔
          ((∃ S : Finset (Fin n), S.card = s ∧
            ∀ e : Finset (Fin n), e ∈ H ↔ e.card = k ∧ ¬ Disjoint e S) ∧
            Nat.choose (k * (s + 1) - 1) k ≤ Nat.choose n k - Nat.choose (n - s) k) ∨
          ((∃ Q : Finset (Fin n), Q.card = k * (s + 1) - 1 ∧
            ∀ e : Finset (Fin n), e ∈ H ↔ e.card = k ∧ e ⊆ Q) ∧
            Nat.choose n k - Nat.choose (n - s) k ≤ Nat.choose (k * (s + 1) - 1) k)) := by
  simpa only [SharpTailMatching.IsUniform, SharpTailMatching.MatchingNumberAtMost,
    SharpTailMatching.coverSize, SharpTailMatching.cliqueSize,
    SharpTailMatching.IsCompleteCover, SharpTailMatching.IsStandardClique]
    using SharpTailMatching.large_matching_equality k hk
